#!/bin/bash
# Stop every user's running macrdp so the app can be replaced.
for plist in /Users/*/Library/LaunchAgents/com.macrdp.server.plist; do
    [ -f "$plist" ] || continue
    owner=$(stat -f%Su "$plist")
    launchctl bootout "gui/$(id -u "$owner")/com.macrdp.server" 2>/dev/null || true
done
exit 0
