#!/bin/bash
# Removes macrdp-server and its login agent. Run with: sudo macrdp-uninstall
# Your config (~/.config/macrdp) and logs (~/Library/Logs/macrdp) are kept.
set -u
if [ "$(id -u)" -ne 0 ]; then
    echo "Run with sudo: sudo macrdp-uninstall" >&2
    exit 1
fi

for plist in /Users/*/Library/LaunchAgents/com.macrdp.server.plist; do
    [ -f "$plist" ] || continue
    owner=$(stat -f%Su "$plist")
    launchctl bootout "gui/$(id -u "$owner")/com.macrdp.server" 2>/dev/null || true
    rm -f "$plist"
    echo "Removed login agent for $owner"
done

rm -rf /Applications/macrdp.app
rm -f /usr/local/bin/macrdp-server
rm -rf /usr/local/share/macrdp
# Drop macrdp's Screen Recording / Accessibility entries
tccutil reset ScreenCapture com.macrdp.server >/dev/null 2>&1 || true
tccutil reset Accessibility com.macrdp.server >/dev/null 2>&1 || true
pkgutil --forget com.macrdp.server >/dev/null 2>&1 || true
echo "macrdp removed. Config and logs in each user's home folder were kept."
rm -f /usr/local/bin/macrdp-uninstall
